{
  "compilerOptions": {
    "strict": false,                // turn off strict mode
    "skipLibCheck": true,           // ignore type errors in node_modules
    "noImplicitAny": false,         // allow "any"
    "baseUrl": "./",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "types": ["node"],   // ❌ removed "recharts"
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": true
  },
  "include": ["src"]
}
