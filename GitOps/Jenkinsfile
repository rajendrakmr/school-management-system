pipeline {
  agent any

  environment {
    EMAILID = 'cloudwithrk@gmail.com'
    FROMEMAIL = 'cloudwithrk@gmail.com'
  }

  parameters {
    string(name: 'FRONTEND_TAG', defaultValue: '', description: 'Docker tag for frontend image')
    string(name: 'BACKEND_TAG', defaultValue: '', description: 'Docker tag for backend image')
    string(name: 'GIT_URL', defaultValue: '', description: 'GitHub repository')
    string(name: 'BRANCH_NAME', defaultValue: '', description: 'GitHub repository branch')
  }

  stages {
    stage("Workspace cleanup") {
      steps {
        cleanWs()
      }
    }

    stage('Git: Code Checkout') {
      steps {
        git branch: "${params.BRANCH_NAME}", url: "${params.GIT_URL}"
      }
    }

    stage("Update: Kubernetes manifest") {
      steps {
        script {
          dir('k8s') {
            sh """
              echo "🔄 Updating K8s manifests with new Docker image tags..."

              # Update frontend deployment
              sed -i -e 's|cloudwithrk/erp-frontend-app:.*|cloudwithrk/erp-frontend-app:${params.FRONTEND_TAG}|g' frontend.yaml

              # Update backend deployment
              sed -i -e 's|cloudwithrk/erp-backend-app:.*|cloudwithrk/erp-backend-app:${params.BACKEND_TAG}|g' backend.yaml
            """
          }
        }
      }
    }

    stage("Git: Commit and Push Changes") {
      steps {
        script {
          withCredentials([usernamePassword(
            credentialsId: 'GithubCreds',
            usernameVariable: 'GIT_USERNAME',
            passwordVariable: 'GIT_PASSWORD'
          )]) {
            sh """
              git config user.email "${FROMEMAIL}"
              git config user.name "Jenkins-CD"

              echo "✅ Adding manifest changes to Git..."
              git add k8s/

              echo "✅ Committing changes..."
              git commit -m "Updated K8s manifests with Frontend:${params.FRONTEND_TAG}, Backend:${params.BACKEND_TAG}" || echo "Nothing to commit"

              echo "📤 Pushing changes to GitHub..."
              git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/${GIT_URL.split('github.com/')[1]} ${params.BRANCH_NAME}
            """
          }
        }
      }
    }
  }
post {
  always {
    script {
      emailext(
        attachLog: true,
        from: "${FROMEMAIL}",
        subject: "🚀 ERP-SMS CD Pipeline Status: ${currentBuild.result}",
        body: """
          <html>
            <body style="font-family: Arial, sans-serif; line-height: 1.6;">
              <h2 style="color:#2E86C1;">📢 ERP-SMS Deployment Report</h2>

              <table style="border-collapse: collapse; width: 100%; max-width: 600px; border: 1px solid #ddd;">
                <tr style="background-color: #f8f9fa;">
                  <td style="padding: 8px; font-weight: bold;">Frontend Image Tag</td>
                  <td style="padding: 8px;">${params.FRONTEND_TAG}</td>
                </tr>
                <tr>
                  <td style="padding: 8px; font-weight: bold;">Backend Image Tag</td>
                  <td style="padding: 8px;">${params.BACKEND_TAG}</td>
                </tr>
                <tr style="background-color: #f8f9fa;">
                  <td style="padding: 8px; font-weight: bold;">Git Branch</td>
                  <td style="padding: 8px;">${params.BRANCH_NAME}</td>
                </tr>
                <tr>
                  <td style="padding: 8px; font-weight: bold;">Build Number</td>
                  <td style="padding: 8px;">#${env.BUILD_NUMBER}</td>
                </tr>
                <tr style="background-color: #f8f9fa;">
                  <td style="padding: 8px; font-weight: bold;">Status</td>
                  <td style="padding: 8px; font-weight: bold; color:${currentBuild.result == 'SUCCESS' ? 'green' : 'red'};">
                    ${currentBuild.result}
                  </td>
                </tr>
                <tr>
                  <td style="padding: 8px; font-weight: bold;">Build URL</td>
                  <td style="padding: 8px;">
                    <a href="${env.BUILD_URL}" style="color: #2980B9;">🔗 View Build Details</a>
                  </td>
                </tr>
              </table>

              <h3 style="margin-top:20px; color:#27AE60;">📊 Attached Reports:</h3>
              <ul>
                <li>✔️ Jenkins Build Log</li>
                <li>✔️ Deployment Manifest Updates</li>
              </ul>

              <p style="margin-top:20px;">
                ✅ ERP-SMS CD Pipeline has completed.<br>
                Please verify deployment in Kubernetes cluster.
              </p>

              <p style="color: #999;">-- DevOps Automation Team</p>
            </body>
          </html>
        """,
        to: "${EMAILID}",
        mimeType: 'text/html'
      )
    }
  }
}
